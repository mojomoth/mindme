{
  "name": "mindme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:pocs": "pnpm --filter @mindme/pocs dev",
    "build": "pnpm --filter @mindme/pocs build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
