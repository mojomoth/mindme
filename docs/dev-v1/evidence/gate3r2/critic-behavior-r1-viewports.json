    "seeded": {
      "titles": [
        {
          "text": "부산 학교로 전학 간 첫날의 서하린",
          "breaks": [
            {
              "at": "전학 간 /첫날의 서",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "가나다라마바사아자차카타파하거너더러머버서어저의서하린",
          "breaks": [
            {
              "at": "사아자차카/타파하거너",
              "atSpace": false
            }
          ],
          "overflowX": false
        },
        {
          "text": "17살의 이지우",
          "breaks": [],
          "overflowX": false
        },
        {
          "text": "열한 번 탈락 끝에 합격한 날의 이지우",
          "breaks": [
            {
              "at": " 합격한 /날의 이지",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "첫 출근에 잔뜩 긴장한 날의 이지우",
          "breaks": [
            {
              "at": " 긴장한 /날의 이지",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "회의에서 의견을 칭찬받은 날의 이지우",
          "breaks": [
            {
              "at": " 의견을 /칭찬받은 ",
              "atSpace": true
            }
          ],
          "overflowX": false
        }
      ],
      "previews": [
        {
          "text": "새 학교 첫날인데 다들 사투리를 써서 하나도 못 알아듣겠어. 오늘 기분 별로야. 그래도 짝꿍이 먼저 말 걸어",
          "breaks": [
            {
              "at": "데 다들 /사투리를 ",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "띄어쓰기 없는 긴 이름도 칸 밖으로 넘치지 않아야 해요.",
          "breaks": [
            {
              "at": "름도 칸 /밖으로 넘",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "내가 뭘 잘못했는데 나만 모르고 있는 걸까 봐 무서웠어. 사수가 말이 없으니까 물어봐도 되나 싶고, 괜히 더",
          "breaks": [
            {
              "at": "데 나만 /모르고 있",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "나 최종 합격했어!!!! 아직도 손이 떨리고 너무 좋은데, 열한 번 떨어졌던 거 생각하니까 이제야 좀 서러워",
          "breaks": [
            {
              "at": " 아직도 /손이 떨리",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "첫 출근 끝! 점심은 다들 바빠서 혼자 먹음 ㅎㅎ 근데 끝나고 나니까 좀 서운하기도 하고, 사수 앞에서 눈치",
          "breaks": [
            {
              "at": "은 다들 /바빠서 혼",
              "atSpace": true
            }
          ],
          "overflowX": false
        },
        {
          "text": "오늘 처음으로 회의에서 의견 냈는데 팀장님이 좋다고 해주셨어. 일주일 내내 긴장했는데 조금 풀리니까, 그동안",
          "breaks": [
            {
              "at": "서 의견 /냈는데 팀",
              "atSpace": true
            }
          ],
          "overflowX": false
        }
      ],
